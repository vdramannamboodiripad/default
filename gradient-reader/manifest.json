{
  "manifest_version": 3,
  "name": "Gradient Reader",
  "version": "0.1.0",
  "description": "Colours each line of an article so it ends on the colour the next line begins with, so your eye keeps its place. Nothing leaves your computer.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "optional_host_permissions": [
    "*://*/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Gradient Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "options_page": "options.html",

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "toggle-page": {
      "suggested_key": { "default": "Alt+G" },
      "description": "Gradient on or off for this page"
    }
  },

  "web_accessible_resources": [
    {
      "resources": ["fonts/*"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": true
    }
  ],

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
