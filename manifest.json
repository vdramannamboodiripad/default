{
  "manifest_version": 3,
  "name": "Rote",
  "version": "0.1.0",
  "description": "Fills the questions every job application asks. Local only, no network access.",

  "permissions": ["storage", "scripting", "activeTab"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_title": "Rote — fill this application",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "options_page": "options.html",

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
